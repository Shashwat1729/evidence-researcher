{
  "name": "evidence-researcher",
  "version": "1.0.0",
  "description": "Evidence-first deep research agent powered by Gemini. Searches the live web, evaluates sources, extracts claims, hunts contradictions, and produces auditable cited reports.",
  "type": "module",
  "homepage": "https://shashwat1729.github.io/evidence-researcher/frontend/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shashwat1729/evidence-researcher.git"
  },
  "bugs": {
    "url": "https://github.com/Shashwat1729/evidence-researcher/issues"
  },
  "author": "Shashwat Bajpai",
  "scripts": {
    "dev": "node backend/src/index.js",
    "start": "NODE_ENV=production node backend/src/index.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "lint": "node scripts/lint.js",
    "keys": "node scripts/validate-keys.js",
    "live": "node scripts/live-research.js",
    "research": "node scripts/research.js",
    "eval": "node eval/run.js --help",
    "mcp": "node mcp/server.js"
  },
  "bin": {
    "evidence-researcher": "./scripts/research.js"
  },
