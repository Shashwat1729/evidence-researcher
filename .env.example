# Required: primary Gemini key (https://aistudio.google.com/apikey)
# Both formats Google issues work: AIza… (standard) and AQ.… (authorization).
# AI Studio has issued only AQ keys since June 2026.
GEMINI_API_KEY=
# Optional: any number of extra keys, separated by commas/spaces/newlines.
# Each key from a DIFFERENT Google Cloud project multiplies the free-tier quota;
# keys from the same project share one bucket, so duplicates are pointless.
#GEMINI_API_KEYS=
# Optional: second project key — doubles effective free-tier RPM via rotation
GEMINI_API_KEY_FALLBACK=
# Optional: Google Custom Search (Programmable Search) — quota-free web complement
# Create a CSE at https://programmablesearchengine.google.com/ (search entire web)
# then set both values. When configured, grounding + CSE run in parallel.
#GOOGLE_CSE_API_KEY=
#GOOGLE_CSE_CX=
PORT=8787
DATA_DIR=./data
# Leave DEFAULT_MODEL unset to use the verified defaults (Flash-Lite for
# planning/analysis, Flash for search and writing). Pinning a model that your
# project cannot serve (the 2.5 family is being retired for newer projects)
# used to kill every synthesis call and downgrade the run to cited extracts.
#DEFAULT_MODEL=
# Optional model overrides (all default to DEFAULT_MODEL)
#PLANNER_MODEL=
#RESEARCH_MODEL=
#ANALYSIS_MODEL=
#SYNTHESIS_MODEL=
# Server hardening (defaults shown)
#MAX_CONCURRENT_RUNS=8
#RATE_LIMIT_MAX=30
#SEARCH_STAGGER_MS=350
# Max keys accepted per request (UI rows, key validation, rotation pool).
#MAX_KEYS_PER_REQUEST=25
# Research budget overrides (JSON, numbers/booleans on known modes/keys only)
#RESEARCH_BUDGETS_JSON={"quick":{"maxSearches":3}}
#CORS_ORIGIN=*
#LOG_LEVEL=info
# Swap the LLM endpoint: any Gemini-compatible gateway (proxy, Vertex shim,
# relay) — same key header contract, different base URL. No code change needed.
#GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Ed25519 private key (PEM, or base64 of the PEM) used to sign delivery
# receipts. Generate one with: openssl genpkey -algorithm ed25519
# If unset, an ephemeral key is generated per process (dev only — receipts
# and the published keys doc change on every restart).
#RECEIPT_PRIVATE_KEY_PEM=
#RECEIPT_ISSUER=evidence-researcher
# Service listing metadata served at GET /api/service (all optional).
#SERVICE_NAME=Evidence Researcher
#SERVICE_PRICE_MINOR=500
#SERVICE_CURRENCY=chf
#SERVICE_LISTING_ID=
#SERVICE_SELLER_ID=
