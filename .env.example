# Required: primary Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: second project key — doubles effective free-tier RPM via rotation
GEMINI_API_KEY_FALLBACK=
# Optional: Google Custom Search (Programmable Search) — quota-free web complement
# Create a CSE at https://programmablesearchengine.google.com/ (search entire web)
# then set both values. When configured, grounding + CSE run in parallel.
#GOOGLE_CSE_API_KEY=
#GOOGLE_CSE_CX=
PORT=8787
DATA_DIR=./data
DEFAULT_MODEL=gemini-2.5-flash
# Optional model overrides (all default to DEFAULT_MODEL)
#PLANNER_MODEL=
#RESEARCH_MODEL=
#ANALYSIS_MODEL=
#SYNTHESIS_MODEL=
# Server hardening (defaults shown)
#MAX_CONCURRENT_RUNS=8
#RATE_LIMIT_MAX=30
#SEARCH_STAGGER_MS=350
# Research budget overrides (JSON, numbers/booleans on known modes/keys only)
#RESEARCH_BUDGETS_JSON={"quick":{"maxSearches":3}}
#CORS_ORIGIN=*
#LOG_LEVEL=info
